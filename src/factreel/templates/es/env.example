# Copia este archivo como .env y rellena las claves que tengas. Todas son opcionales:
# sin ninguna clave FactReel funciona igual (hechos leídos tal cual, voz gratuita de Edge, imágenes sin conexión).
NVIDIA_API_KEY=            # https://build.nvidia.com  (gratis) - IA del guion + imágenes FLUX
GOOGLE_API_KEY=            # https://aistudio.google.com/apikey (gratis) - IA del guion alternativa (Gemini), ver docs/configuration.md
CLOUDFLARE_ACCOUNT_ID=     # https://dash.cloudflare.com (cupo diario gratis) - imágenes, voz de reserva, tiempos con Whisper
CLOUDFLARE_API_TOKEN=
ELEVENLABS_API_KEY=        # https://elevenlabs.io (opcional, voz premium)
