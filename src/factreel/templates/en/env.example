# Copy this file to .env and fill in the keys you have. All of them are optional:
# without any key FactReel still works (facts read as-is, free Edge voice, offline images).
NVIDIA_API_KEY=            # https://build.nvidia.com  (free) - script AI + FLUX images
CLOUDFLARE_ACCOUNT_ID=     # https://dash.cloudflare.com (free daily quota) - images, backup voice, Whisper timings
CLOUDFLARE_API_TOKEN=
ELEVENLABS_API_KEY=        # https://elevenlabs.io (optional, premium voice)
